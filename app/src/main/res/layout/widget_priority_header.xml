<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="28dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="4dp" android:paddingTop="6dp" android:paddingBottom="6dp">
    <TextView android:id="@+id/widget_priority" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="10sp" android:letterSpacing="0.02"
        android:textColor="#87BAC9D9" android:maxLines="1" />
    <ImageView android:id="@+id/widget_priority_divider" android:layout_width="0dp"
        android:layout_weight="1" android:layout_height="1dp" android:layout_marginStart="8dp"
        android:background="#18FFFFFF" android:importantForAccessibility="no" android:contentDescription="@null" />
</LinearLayout>
